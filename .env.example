# Copy to .env and fill in. Used by docker compose AND the API (apps/api reads this file).
# Never commit .env.

# ── Database ───────────────────────────────────────────────
POSTGRES_USER=scentvault
# Fresh install: pick a strong password. Existing pre-2.0 volume: keep the password it was created with.
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=scentvault
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://scentvault:change-this-password@localhost:5432/scentvault

# ── Security ───────────────────────────────────────────────
# Required, at least 32 characters. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Comma-separated origins allowed to call the API from a browser (the admin panel).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Background jobs ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# auto = use Redis if reachable, otherwise run jobs inside the API process
JOB_QUEUE=auto

# ── AI ─────────────────────────────────────────────────────
# auto = sentence-transformers if installed (pip install -e ".[ml]"), else a hashing fallback
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=all-MiniLM-L6-v2
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Money / locale ─────────────────────────────────────────
DEFAULT_CURRENCY=EUR
# Catalog prices are stored in USD; these rates convert for display.
CURRENCY_RATES={"USD": 1.0, "EUR": 0.92, "RSD": 108.0, "GBP": 0.79}

# ── Optional integrations ──────────────────────────────────
WEATHER_ENABLED=true
PUSH_ENABLED=true

# Build the Docker image with the real embedding model (adds ~1 GB). 0 = hashing fallback.
WITH_ML=1
